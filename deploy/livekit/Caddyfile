# 猫娘串门 · LiveKit 节点前置 Caddy（必须是带 caddy-l4 插件的构建，见 README「构建 caddy-l4」）
#
# 443 上做四层 SNI 分流：
#   - TURN 独立域名（TURN_DOMAIN）→ 终结 TLS → 127.0.0.1:5349（LiveKit TURN，livekit.yaml turn.external_tls: true）
#   - 信令域名（LIVEKIT_DOMAIN）   → 终结 TLS → 127.0.0.1:7880（LiveKit HTTP / WebSocket）
# 普通 HTTP 反代转不了 TURN/TLS 的裸 TLS 流量，所以 443 交给 layer4，HTTP app 不占 443。
#
# 域名与邮箱来自环境变量（docker-compose.yml 从 .env 注入），本文件不写真实值。
# caddy-l4 的 Caddyfile 语法仍在演进：换插件版本后先跑 `caddy validate --config Caddyfile --adapter caddyfile`。

{
	email {$ACME_EMAIL}
	# 站点块（下面）只用来申请 / 续期证书；把 HTTP app 的 HTTPS 端口挪开，443 留给 layer4。
	# 8443 不对外放行，证书走 80 端口的 HTTP-01 验证。
	https_port 8443

	layer4 {
		:443 {
			@turn tls sni {$TURN_DOMAIN}
			route @turn {
				tls
				proxy 127.0.0.1:5349
			}

			@signal tls sni {$LIVEKIT_DOMAIN}
			route @signal {
				tls {
					# LiveKit 信令端口只说 HTTP/1.1（含 WebSocket 升级），不协商 h2
					connection_policy {
						alpn http/1.1
					}
				}
				proxy 127.0.0.1:7880
			}
		}
	}
}

# 让 Caddy 为两个域名自动申请并续期证书；证书进 Caddy 的证书缓存，上面 layer4 的 tls 处理器按 SNI 取用。
{$LIVEKIT_DOMAIN}, {$TURN_DOMAIN} {
	respond 404
}
