pkgname=n.e.k.o-bin
pkgver=0.9.0.1
# 上游 release tag 和 pkgver 不一定相同（0.9.0.1 的文件挂在 v0.9.0 下），升级时两个一起改
_tag=v0.9.0
pkgrel=1
provides=('n.e.k.o')
conflicts=('n.e.k.o')
pkgdesc="N.E.K.O., a digital life that yearns to understand, connect, and grow with us."
arch=('x86_64')
url="https://github.com/Project-N-E-K-O/N.E.K.O"
license=('Apache-2.0')
depends=('gtk3' 'nss' 'libxtst' 'libsecret' 'xdg-utils')
makedepends=()
# 注意：上游文件名写的是 x86，这里照抄
source=("$pkgname-$pkgver.AppImage::https://github.com/Project-N-E-K-O/N.E.K.O/releases/download/${_tag}/N.E.K.O_v${pkgver}_x86_linux.AppImage")
sha256sums=('8d8c9c3b79ac2b35db56ed0bbdf58b901b2ec980cb2d318b6511133c763fa618')

package() {
  cd "$srcdir"

  # 1. 解包 AppImage
  #    先清掉上次构建留下的 squashfs-root：--appimage-extract 只覆盖写入，
  #    不清空的话旧版本里已经删掉的文件会被一起打进包
  rm -rf squashfs-root
  chmod +x "$pkgname-$pkgver.AppImage"
  ./"$pkgname-$pkgver.AppImage" --appimage-extract > /dev/null
  # 解包后生成 squashfs-root

  # 2. 把解包目录整个移到 /usr/lib/neko
  #    解包后有近 4 GB，用 mv 而不是 cp，免得构建时再多占一份磁盘
  mkdir -p "$pkgdir/usr/lib"
  mv squashfs-root "$pkgdir/usr/lib/neko"
  # --appimage-extract 解出来的目录全是 700（AppImage 里本来是 755），
  # 装好后归 root 所有，不改的话普通用户进不去、程序起不来
  find "$pkgdir/usr/lib/neko" -type d -exec chmod 755 {} +

  # 3. 确认入口：AppImage 根目录的 AppRun 会自己判断要不要加 --no-sandbox
  if [ ! -x "$pkgdir/usr/lib/neko/AppRun" ]; then
      echo "错误：AppImage 根目录没有 AppRun，上游打包结构可能变了，请手动检查！" >&2
      return 1
  fi

  # 4. 创建启动脚本
  mkdir -p "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/n.e.k.o" << 'EOF'
#!/bin/sh
cd /usr/lib/neko
exec ./AppRun "$@"
EOF
  chmod +x "$pkgdir/usr/bin/n.e.k.o"

  # 5. 安装 .desktop 文件：优先用 AppImage 自带的，改掉 Exec 和 Icon
  mkdir -p "$pkgdir/usr/share/applications"
  local _desktop_file="$pkgdir/usr/lib/neko/n.e.k.o.desktop"

  if [ -f "$_desktop_file" ]; then
      # 上游是 Exec=AppRun --no-sandbox %U；保留 %U，让拖到启动器上的文件/链接能传给程序
      sed -i -e "s|^Exec=.*|Exec=n.e.k.o %U|" -e "s|^Icon=.*|Icon=neko-bin|" "$_desktop_file"
      install -Dm644 "$_desktop_file" "$pkgdir/usr/share/applications/$pkgname.desktop"
  else
      # 如果没找到，沿用你之前的写法
      cat > "$pkgdir/usr/share/applications/$pkgname.desktop" << EOF
[Desktop Entry]
Type=Application
Name=Project N.E.K.O
Comment=N.E.K.O., a digital life that yearns to understand, connect, and grow with us.
Exec=n.e.k.o %U
Icon=neko-bin
Categories=Utility;
Terminal=false
StartupNotify=true
EOF
  fi

  # 6. 安装图标：直接用 AppImage 自带的应用图标，不要按文件名搜 "icon"
  #    （resources 下有上百张界面素材的路径也带 icon，find 的顺序不固定，会装错图）
  local _icon_file=""
  for _candidate in \
      "$pkgdir/usr/lib/neko/usr/share/icons/hicolor/512x512/apps/n.e.k.o.png" \
      "$pkgdir/usr/lib/neko/.DirIcon"; do
    if [ -e "$_candidate" ]; then
      _icon_file="$_candidate"
      break
    fi
  done
  if [ -n "$_icon_file" ]; then
    install -Dm644 "$_icon_file" "$pkgdir/usr/share/pixmaps/neko-bin.png"
  else
    echo "警告：AppImage 里没找到应用图标，桌面项将显示默认图标" >&2
  fi
}
